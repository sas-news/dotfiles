/*
/.**

# ホワイトリスト
!/stow/
stow/*
!/stow/zsh/
!/stow/zsh/**
!/stow/nvim/
!/stow/nvim/**
!/stow/ghostty/
!/stow/ghostty/**
!/stow/git/
!/stow/git/**
!/stow/bin/
!/stow/bin/**
!/stow/tmux/
!/stow/tmux/**
!/stow/ssh/
!/stow/ssh/**
# NEVER track keys — only `config` may live under stow/ssh/.ssh/.
# If ~/.ssh became a dir symlink into the repo, generated keys would
# land here and a careless `git add -A` would publish them.
stow/ssh/.ssh/id_*
stow/ssh/.ssh/authorized_keys
stow/ssh/.ssh/known_hosts*
!/stow/bat/
!/stow/bat/**
!/stow/lazygit/
!/stow/lazygit/**
!/stow/yazi/
!/stow/yazi/**

!/docs/
!/docs/**
!/packages/
!/packages/**
!/tests/
!/tests/**
!/mise.toml
!/justfile
!/AGENTS.md
!/README.md
!/LICENSE
!.gitignore

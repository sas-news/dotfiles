[user]
	email = 109570410+sas-news@users.noreply.github.com
	name = SAS NEWS
[url "git@github.com:"]
	InsteadOf = https://github.com/

[core]
	excludesfile = ~/.gitignore_global
	editor = sh -c 'command -v nvim >/dev/null 2>&1 && exec nvim "$@" || command -v nano >/dev/null 2>&1 && exec nano "$@" || exec vi "$@"' sh
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = "Catppuccin Mocha"
[merge]
	conflictstyle = zdiff3
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate
	br = branch -vv
	sw = switch
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !command -v gh >/dev/null 2>&1 && exit 0 || gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !command -v gh >/dev/null 2>&1 && exit 0 || gh auth git-credential
